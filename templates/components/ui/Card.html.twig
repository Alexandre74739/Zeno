{% props icon, title, description %}

<div class="flex flex-col items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-8 text-center transition-colors duration-300 hover:border-lime/30 lg:items-start lg:text-left">
    <div class="flex size-12 items-center justify-center rounded-xl bg-lime/10">
        <i data-lucide="{{ icon }}" class="size-6 text-lime"></i>
    </div>
    <h3 class="text-lg font-bold text-cream">{{ title }}</h3>
    <p class="text-sm text-taupe">{{ description }}</p>
</div>
