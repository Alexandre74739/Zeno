{% extends 'base.html.twig' %}

{% form_theme registrationForm 'form/tailwind_theme.html.twig' %}

{% block title %}{{ 'registration.meta_title'|trans }}{% endblock %}

{% block body %}
    <section class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-ink px-6 py-24 lg:px-10">
        <div class="relative mx-auto w-full max-w-5xl overflow-hidden rounded-3xl border border-white/10 bg-surface/60 shadow-2xl shadow-black/40 lg:grid lg:grid-cols-2 lg:min-h-[75vh]">
            <div class="relative hidden flex-col items-center justify-center gap-12 overflow-hidden bg-linear-to-b from-lime/10 via-transparent to-transparent p-12 text-center lg:flex">
                <div class="pointer-events-none absolute size-72 rounded-full bg-lime/20 blur-3xl" aria-hidden="true"></div>

                <img src="{{ asset('logos/Logo-happy.svg') }}" alt="" draggable="false" oncontextmenu="return false" class="relative h-64 w-auto select-none [-webkit-user-drag:none]">

                <div class="flex flex-col gap-3">
                    <p class="text-3xl font-extrabold leading-tight text-cream">
                        {{ 'registration.panel_heading'|trans }}
                    </p>
                    <p class="max-w-xs text-taupe">
                        {{ 'registration.panel_description'|trans }}
                    </p>
                </div>

                <ul class="flex w-full max-w-xs flex-col gap-5 text-left">
                    <li class="flex items-center gap-3">
                        <i data-lucide="save" class="size-5 shrink-0 text-lime" aria-hidden="true"></i>
                        <span class="text-sm text-taupe">{{ 'registration.panel_benefit_save'|trans }}</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <i data-lucide="cat" class="size-5 shrink-0 text-lime" aria-hidden="true"></i>
                        <span class="text-sm text-taupe">{{ 'registration.panel_benefit_cat'|trans }}</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <i data-lucide="shield-check" class="size-5 shrink-0 text-lime" aria-hidden="true"></i>
                        <span class="text-sm text-taupe">{{ 'registration.panel_benefit_secure'|trans }}</span>
                    </li>
                </ul>
            </div>

            <div class="flex flex-col justify-center gap-6 p-6 sm:p-10 lg:p-14">
                <h1 class="text-center text-2xl font-extrabold leading-tight text-cream lg:text-left lg:text-4xl">
                    {{ 'registration.heading'|trans }}
                </h1>

                {{ form_errors(registrationForm) }}

                {{ form_start(registrationForm, {attr: {class: 'flex flex-col gap-5'}}) }}
                    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
                        {{ form_row(registrationForm.prenom) }}
                        {{ form_row(registrationForm.nom) }}
                    </div>

                    {{ form_row(registrationForm.telephone) }}
                    {{ form_row(registrationForm.email) }}

                    <div class="flex flex-col gap-2" data-controller="password-strength" data-password-strength-labels-value="{{ [
                        'registration.password_strength_low'|trans,
                        'registration.password_strength_medium'|trans,
                        'registration.password_strength_good'|trans,
                        'registration.password_strength_excellent'|trans,
                    ]|json_encode }}">
                        {{ form_label(registrationForm.plainPassword) }}
                        <div class="relative">
                            <i data-lucide="lock-keyhole" class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-taupe" aria-hidden="true"></i>
                            {{ form_widget(registrationForm.plainPassword, {
                                attr: {
                                    'data-password-strength-target': 'input',
                                    'data-action': 'input->password-strength#update',
                                },
                            }) }}
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/10">
                                <div class="h-full w-0 rounded-full transition-all duration-300 ease-out" data-password-strength-target="bar"></div>
                            </div>
                            <p class="text-xs font-bold" data-password-strength-target="label">&nbsp;</p>
                        </div>

                        <ul class="grid grid-cols-1 gap-x-4 gap-y-1.5 sm:grid-cols-2">
                            <li class="flex items-center gap-2 text-xs text-taupe transition-colors duration-200" data-password-strength-target="requirement" data-requirement="length">
                                <span class="size-2 shrink-0 scale-100 rounded-full bg-taupe/30 transition-all duration-200" data-password-strength-dot aria-hidden="true"></span>
                                {{ 'registration.password_requirement_length'|trans }}
                            </li>
                            <li class="flex items-center gap-2 text-xs text-taupe transition-colors duration-200" data-password-strength-target="requirement" data-requirement="uppercase">
                                <span class="size-2 shrink-0 scale-100 rounded-full bg-taupe/30 transition-all duration-200" data-password-strength-dot aria-hidden="true"></span>
                                {{ 'registration.password_requirement_uppercase'|trans }}
                            </li>
                            <li class="flex items-center gap-2 text-xs text-taupe transition-colors duration-200" data-password-strength-target="requirement" data-requirement="lowercase">
                                <span class="size-2 shrink-0 scale-100 rounded-full bg-taupe/30 transition-all duration-200" data-password-strength-dot aria-hidden="true"></span>
                                {{ 'registration.password_requirement_lowercase'|trans }}
                            </li>
                            <li class="flex items-center gap-2 text-xs text-taupe transition-colors duration-200" data-password-strength-target="requirement" data-requirement="number">
                                <span class="size-2 shrink-0 scale-100 rounded-full bg-taupe/30 transition-all duration-200" data-password-strength-dot aria-hidden="true"></span>
                                {{ 'registration.password_requirement_number'|trans }}
                            </li>
                            <li class="flex items-center gap-2 text-xs text-taupe transition-colors duration-200" data-password-strength-target="requirement" data-requirement="symbol">
                                <span class="size-2 shrink-0 scale-100 rounded-full bg-taupe/30 transition-all duration-200" data-password-strength-dot aria-hidden="true"></span>
                                {{ 'registration.password_requirement_symbol'|trans }}
                            </li>
                        </ul>

                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    {{ form_row(registrationForm.rgpdConsent, {
                        label: 'registration.rgpd_consent_label'|trans({
                            '%link_start%': '<a href="' ~ path('app_privacy_policy', {_locale: app.request.locale}) ~ '" class="font-bold text-lime underline hover:no-underline" target="_blank" rel="noopener">',
                            '%link_end%': '</a>',
                        }),
                    }) }}

                    <button type="submit" class="mt-1 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-lime px-8 py-4 font-bold text-ink transition-all duration-300 ease-out hover:bg-hover hover:shadow-[0_0_24px_rgba(211,255,46,0.5)]">
                        {{ 'registration.submit'|trans }}
                    </button>
                {{ form_end(registrationForm) }}

                <p class="text-center text-sm text-taupe">
                    {{ 'registration.already_have_account'|trans }}
                    <a href="{{ path('app_login', {_locale: app.request.locale}) }}" class="font-bold text-lime hover:underline">
                        {{ 'registration.login_link'|trans }}
                    </a>
                </p>
            </div>
        </div>
    </section>
{% endblock %}
