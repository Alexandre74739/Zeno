{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block body %}
    <twig:sections:Hero/>

    <twig:sections:About
        heading="{{ 'about.heading'|trans }}"
        highlight="{{ 'about.highlight'|trans }}"
        description="{{ 'about.description'|trans }}"
        image="logos/Logo.svg"
        imageAlt="Zeno"
    />

    <twig:sections:Features/>

    <twig:sections:About
        heading="{{ 'about_progress.heading'|trans }}"
        highlight="{{ 'about_progress.highlight'|trans }}"
        description="{{ 'about_progress.description'|trans }}"
        image="logos/Logo-happy.svg"
        imageAlt="Zeno content"
        :reverse="true"
    />

    <twig:sections:About
        heading="{{ 'about_discover.heading'|trans }}"
        highlight="{{ 'about_discover.highlight'|trans }}"
        description="{{ 'about_discover.description'|trans }}"
        image="logos/Logo-choc.svg"
        imageAlt="Zeno surpris"
    />

    <twig:sections:About
        heading="{{ 'about_streak.heading'|trans }}"
        highlight="{{ 'about_streak.highlight'|trans }}"
        description="{{ 'about_streak.description'|trans }}"
        image="logos/Logo-sad.svg"
        imageAlt="Zeno triste"
        :reverse="true"
    />

    <twig:sections:Bandeau/>
{% endblock %}
