{% extends 'base.html.twig' %}

{% block title %}Prêt pour Zeno ?{% endblock %}

{% block body %}
    <main class="relative flex h-screen flex-col items-center justify-center gap-8 overflow-hidden bg-ink px-6 text-center lg:text-left">
        <div class="relative flex w-full max-w-6xl flex-col items-center gap-8 lg:grid lg:grid-cols-2 lg:items-center lg:gap-16">
            <img src="{{ asset('logos/Logo-body.svg') }}" alt="Zeno le chat" class="h-36 w-auto lg:order-2 lg:h-auto lg:w-full lg:max-w-lg lg:justify-self-center lg:animate-wiggle">

            <div class="flex flex-col items-center gap-8 lg:order-1 lg:items-start lg:gap-8">
                <div class="flex flex-col items-center gap-3 lg:items-start lg:gap-4 lg:animate-fade-in-up">
                    <h1 class="text-nowrap text-4xl font-extrabold leading-tight text-cream lg:text-6xl">
                        Prêt pour <span class="text-lime">Zeno</span> ?
                    </h1>
                    <p class="max-w-xs text-base text-taupe lg:max-w-md lg:text-xl">
                        Une question par jour pour nourrir votre chat et faire grandir vos connaissances.
                    </p>
                </div>

                <div class="flex w-full max-w-xs flex-col items-center gap-3 lg:w-auto lg:max-w-none lg:flex-row lg:items-center lg:gap-6 lg:animate-fade-in-up lg:[animation-delay:150ms]">
                    <twig:ui:Button href="#" variant="primary" class="w-full lg:w-auto lg:px-10">C'est parti !</twig:ui:Button>
                    <twig:ui:Button href="#" variant="secondary">J'ai déjà un compte</twig:ui:Button>
                </div>

                <div class="hidden items-center gap-8 lg:flex lg:animate-fade-in-up lg:[animation-delay:300ms]">
                    <div class="flex items-center gap-2 text-sm text-taupe">
                        <i data-lucide="calendar-days" class="size-5 text-lime"></i>
                        Une question par jour
                    </div>
                    <div class="flex items-center gap-2 text-sm text-taupe">
                        <i data-lucide="brain" class="size-5 text-lime"></i>
                        Culture générale
                    </div>
                    <div class="flex items-center gap-2 text-sm text-taupe">
                        <i data-lucide="sparkles" class="size-5 text-lime"></i>
                        100% gratuit
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
