{% extends 'base.html.twig' %}

{% block title %}{{ 'learn.meta_title'|trans }}{% endblock %}

{% block body %}
    <section class="flex min-h-screen flex-col items-center justify-center gap-6 bg-ink px-6 py-24 text-center lg:px-16">
        <div class="flex size-16 items-center justify-center rounded-2xl bg-lime/10">
            <i data-lucide="sparkles" class="size-8 text-lime"></i>
        </div>

        <h1 class="text-3xl font-extrabold leading-tight text-cream lg:text-4xl">
            {{ 'learn.heading'|trans({'%prenom%': app.user.prenom}) }}
        </h1>
        <p class="max-w-lg text-taupe">
            {{ 'learn.coming_soon'|trans }}
        </p>
    </section>
{% endblock %}
