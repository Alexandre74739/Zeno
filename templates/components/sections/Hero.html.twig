<main class="relative flex h-screen flex-col items-center justify-center gap-8 overflow-hidden bg-ink px-6 text-center lg:px-16 lg:text-left">
    <div class="relative flex w-full max-w-7xl flex-col items-center gap-8 lg:grid lg:grid-cols-2 lg:items-center lg:gap-16">
        <img src="{{ asset('logos/Logo-body.svg') }}" alt="Zeno le chat" draggable="false" oncontextmenu="return false" class="select-none [-webkit-user-drag:none] h-36 w-auto lg:order-2 lg:h-auto lg:w-full lg:max-w-lg lg:justify-self-center lg:animate-wiggle">

        <div class="flex flex-col items-center gap-8 lg:order-1 lg:items-start lg:gap-8">
            <div class="flex flex-col items-center gap-3 lg:items-start lg:gap-4 lg:animate-fade-in-up">
                <h1 class="text-4xl font-extrabold leading-tight text-cream lg:text-5xl">
                    {{ 'home.heading_before'|trans }} <span class="text-lime">Zeno</span> {{ 'home.heading_after'|trans }}
                </h1>
                <p class="max-w-lg text-lg text-taupe lg:max-w-md lg:text-xl">
                    {{ 'home.subtitle'|trans }}
                </p>
            </div>

            <div class="flex w-full max-w-xs flex-col items-center gap-3 lg:w-auto lg:max-w-none lg:flex-row lg:items-center lg:gap-6 lg:animate-fade-in-up lg:[animation-delay:300ms]">
                {% if app.user %}
                    <twig:ui:Button href="{{ path('app_learn', {_locale: app.request.locale}) }}" variant="primary" class="w-full lg:w-auto lg:px-10">{{ 'home.cta_primary'|trans }}</twig:ui:Button>
                {% else %}
                    <twig:ui:Button href="{{ path('app_register', {_locale: app.request.locale}) }}" variant="primary" class="w-full lg:w-auto lg:px-10">{{ 'home.cta_primary'|trans }}</twig:ui:Button>
                    <twig:ui:Button href="{{ path('app_login', {_locale: app.request.locale}) }}" variant="secondary">{{ 'home.cta_secondary'|trans }}</twig:ui:Button>
                {% endif %}
            </div>

            <div class="hidden items-center gap-8 lg:flex lg:animate-fade-in-up lg:[animation-delay:600ms]">
                <div class="flex items-center gap-2 text-sm text-taupe">
                    <i data-lucide="calendar-days" class="size-5 text-lime"></i>
                    {{ 'home.highlight_daily'|trans }}
                </div>
                <div class="flex items-center gap-2 text-sm text-taupe">
                    <i data-lucide="brain" class="size-5 text-lime"></i>
                    {{ 'home.highlight_culture'|trans }}
                </div>
                <div class="flex items-center gap-2 text-sm text-taupe">
                    <i data-lucide="sparkles" class="size-5 text-lime"></i>
                    {{ 'home.highlight_free'|trans }}
                </div>
            </div>
        </div>
    </div>
</main>
